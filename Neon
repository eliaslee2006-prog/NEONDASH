<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<meta name="color-scheme" content="dark">
<meta name="description" content="Cyberpunk personal operations dashboard">
<title>NEON // OPERATIONS DASHBOARD</title>

<!-- Sole external runtime dependency -->
<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

<style>
/* =========================================================
   NEON // OPERATIONS DASHBOARD
   Self-contained CSS
   ========================================================= */

:root {
  --bg: #0a0813;
  --bg-2: #120c1f;
  --bg-3: #171025;
  --panel: rgba(18, 12, 31, 0.94);
  --panel-2: rgba(10, 8, 19, 0.88);

  --red: #ff0055;
  --red-2: #ff2a2a;
  --pink: #ff71ce;
  --pink-2: #ff00a0;
  --cyan: #00f3ff;

  --text: #eee9ff;
  --muted: #a9a0c7;
  --dim: #706887;

  --border: rgba(255, 0, 85, 0.72);
  --border-soft: rgba(169, 160, 199, 0.2);

  --shadow-red: 0 0 10px rgba(255, 0, 85, .3);
  --shadow-pink: 0 0 14px rgba(255, 0, 160, .28);
  --shadow-cyan: 0 0 12px rgba(0, 243, 255, .25);

  --radius: 4px;
  --gap: 14px;
  --mono: "Courier New", Consolas, Monaco, monospace;
  --sans: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
}

* {
  box-sizing: border-box;
}

html {
  min-width: 0;
  background: var(--bg);
  color: var(--text);
  font-family: var(--sans);
}

body {
  min-width: 0;
  margin: 0;
  overflow-x: hidden;
  background:
    radial-gradient(circle at 10% 0%, rgba(255, 0, 85, .08), transparent 30%),
    radial-gradient(circle at 90% 10%, rgba(0, 243, 255, .045), transparent 28%),
    linear-gradient(180deg, #0a0813 0%, #0d0917 50%, #08070e 100%);
}

/* CRT scanline / grid atmosphere */
body::before {
  content: "";
  position: fixed;
  inset: 0;
  z-index: -1;
  pointer-events: none;
  opacity: .18;
  background:
    linear-gradient(rgba(255,255,255,.018) 1px, transparent 1px),
    linear-gradient(90deg, rgba(255,255,255,.012) 1px, transparent 1px);
  background-size: 32px 32px;
}

body::after {
  content: "";
  position: fixed;
  inset: 0;
  z-index: 1000;
  pointer-events: none;
  opacity: .035;
  background: repeating-linear-gradient(
    0deg,
    transparent 0,
    transparent 2px,
    #fff 3px
  );
}

button,
input,
textarea,
select {
  font: inherit;
}

button {
  cursor: pointer;
}

input,
textarea,
select {
  width: 100%;
  color: var(--text);
  background: #0b0913;
  border: 1px solid rgba(169,160,199,.24);
  border-radius: var(--radius);
  outline: none;
  transition: border-color .15s, box-shadow .15s, background .15s;
}

input:focus,
textarea:focus,
select:focus {
  border-color: var(--cyan);
  box-shadow: var(--shadow-cyan);
  background: #100c1b;
}

input[type="number"],
input[type="time"],
.mono {
  font-family: var(--mono);
}

button {
  color: var(--text);
  background: #160d24;
  border: 1px solid var(--border);
  padding: 8px 11px;
  border-radius: var(--radius);
  box-shadow: var(--shadow-red);
  transition: .15s ease;
}

button:hover {
  color: #fff;
  border-color: var(--pink);
  box-shadow: 0 0 15px rgba(255,0,160,.38);
  transform: translateY(-1px);
}

button:active {
  transform: translateY(0);
}

button.primary {
  background: rgba(255,0,85,.12);
  border-color: var(--pink);
}

button.cyan {
  border-color: var(--cyan);
  box-shadow: var(--shadow-cyan);
}

button.danger {
  background: rgba(255,0,85,.2);
  border-color: var(--red-2);
}

.small {
  font-size: 11px;
}

.muted {
  color: var(--muted);
}

.dim {
  color: var(--dim);
}

.mono {
  font-family: var(--mono);
}

.app {
  width: min(1800px, 100%);
  margin: 0 auto;
  padding: clamp(10px, 2vw, 24px);
}

.dashboard {
  display: grid;
  grid-template-columns: repeat(12, minmax(0, 1fr));
  gap: var(--gap);
  container-type: inline-size;
}

.module {
  min-width: 0;
  background:
    linear-gradient(145deg, rgba(255,0,85,.035), transparent 35%),
    var(--panel);
  border: 1px solid var(--border);
  border-radius: var(--radius);
  box-shadow: var(--shadow-red);
  overflow: hidden;
}

.module-header {
  min-width: 0;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12px;
  padding: 11px 13px;
  border-bottom: 1px solid rgba(255,0,85,.28);
  background: rgba(255,0,85,.045);
}

.module-title {
  margin: 0;
  font-family: var(--mono);
  font-size: 13px;
  letter-spacing: .11em;
  text-transform: uppercase;
  color: var(--pink);
}

.module-title::before {
  content: "// ";
  color: var(--cyan);
}

.module-body {
  min-width: 0;
  padding: 14px;
}

.header-module {
  grid-column: 1 / -1;
}

.timetable-module {
  grid-column: 1 / -1;
}

.checklist-module {
  grid-column: span 4;
}

.shift-module {
  grid-column: span 4;
}

.budget-module {
  grid-column: span 4;
}

.goals-module {
  grid-column: 1 / -1;
}

/* =========================================================
   Header / Clock
   ========================================================= */

.header-grid {
  display: grid;
  grid-template-columns: minmax(0, 1.6fr) minmax(280px, .8fr);
  gap: 18px;
  align-items: stretch;
}

.clock-console {
  min-width: 0;
  display: flex;
  flex-direction: column;
  justify-content: center;
  padding: 10px;
}

.clock-label {
  color: var(--cyan);
  font-family: var(--mono);
  font-size: 11px;
  letter-spacing: .18em;
  margin-bottom: 5px;
}

.clock {
  min-width: 0;
  font-family: var(--mono);
  font-size: clamp(38px, 8vw, 92px);
  line-height: .95;
  font-weight: 700;
  letter-spacing: .06em;
  color: #ff5da0;
  text-shadow:
    0 0 3px #fff,
    0 0 8px var(--pink),
    0 0 22px var(--red),
    0 0 42px rgba(255,0,85,.65);
  white-space: nowrap;
  overflow: hidden;
  text-overflow: clip;
}

.date-readout {
  margin-top: 9px;
  font-family: var(--mono);
  font-size: 12px;
  color: var(--muted);
}

.alarm-panel {
  min-width: 0;
  display: grid;
  grid-template-columns: 1fr auto;
  gap: 10px;
  align-content: center;
  padding: 14px;
  border: 1px solid rgba(255,113,206,.25);
  background: rgba(0,0,0,.18);
}

.alarm-panel label {
  display: block;
  margin-bottom: 5px;
  font-family: var(--mono);
  color: var(--muted);
  font-size: 10px;
  text-transform: uppercase;
  letter-spacing: .08em;
}

.alarm-time {
  font-size: 22px;
  padding: 8px;
  font-family: var(--mono);
}

.arm-control {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  min-width: 70px;
  gap: 5px;
}

.switch {
  position: relative;
  width: 46px;
  height: 24px;
  display: inline-block;
}

.switch input {
  opacity: 0;
  width: 0;
  height: 0;
}

.slider {
  position: absolute;
  inset: 0;
  border: 1px solid var(--dim);
  border-radius: 999px;
  background: #09070d;
  transition: .2s;
}

.slider::before {
  content: "";
  position: absolute;
  width: 16px;
  height: 16px;
  left: 3px;
  top: 3px;
  border-radius: 50%;
  background: var(--muted);
  transition: .2s;
}

.switch input:checked + .slider {
  border-color: var(--pink);
  box-shadow: 0 0 12px rgba(255,0,160,.5);
}

.switch input:checked + .slider::before {
  transform: translateX(22px);
  background: var(--pink);
  box-shadow: 0 0 10px var(--pink);
}

.arm-label {
  font-family: var(--mono);
  font-size: 9px;
  color: var(--muted);
}

.audio-test {
  grid-column: 1 / -1;
  display: flex;
  gap: 8px;
  align-items: center;
  flex-wrap: wrap;
}

.alarm-banner {
  display: none;
  grid-column: 1 / -1;
  padding: 11px;
  text-align: center;
  font-family: var(--mono);
  font-weight: 700;
  letter-spacing: .14em;
  color: #fff;
  background: rgba(255,0,85,.22);
  border: 1px solid var(--red-2);
  box-shadow: 0 0 18px rgba(255,0,85,.7);
  animation: alarmPulse .65s infinite alternate;
}

.alarm-banner.active {
  display: block;
}

@keyframes alarmPulse {
  from { opacity: .55; }
  to {
    opacity: 1;
    box-shadow: 0 0 35px rgba(255,0,85,.9);
  }
}

/* =========================================================
   Timetable
   ========================================================= */

.week-toolbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 10px;
  flex-wrap: wrap;
  margin-bottom: 12px;
}

.week-label {
  font-family: var(--mono);
  color: var(--cyan);
  font-size: 13px;
}

.week-actions {
  display: flex;
  gap: 6px;
  flex-wrap: wrap;
}

.timetable-scroll {
  width: 100%;
  min-width: 0;
  overflow: hidden;
}

.timetable {
  width: 100%;
  display: grid;
  grid-template-columns: 54px repeat(7, minmax(0, 1fr));
  border-top: 1px solid rgba(169,160,199,.18);
  border-left: 1px solid rgba(169,160,199,.18);
}

.time-head,
.day-head,
.time-cell,
.schedule-cell {
  min-width: 0;
  border-right: 1px solid rgba(169,160,199,.16);
  border-bottom: 1px solid rgba(169,160,199,.16);
}

.time-head,
.day-head {
  min-height: 47px;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 5px;
  background: #100b1b;
}

.time-head {
  color: var(--dim);
  font-family: var(--mono);
  font-size: 9px;
}

.day-head {
  flex-direction: column;
  color: var(--pink);
  font-family: var(--mono);
  font-size: 11px;
  text-align: center;
}

.day-head .day-date {
  margin-top: 3px;
  color: var(--muted);
  font-size: 9px;
}

.time-cell {
  min-height: 42px;
  display: flex;
  align-items: flex-start;
  justify-content: center;
  padding: 6px 2px;
  color: var(--dim);
  background: rgba(0,0,0,.18);
  font-family: var(--mono);
  font-size: 9px;
}

.schedule-cell {
  min-height: 42px;
  background:
    linear-gradient(90deg, rgba(255,0,85,.015), transparent);
}

.schedule-cell input {
  height: 100%;
  min-height: 41px;
  border: 0;
  border-radius: 0;
  padding: 6px;
  background: transparent;
  font-family: var(--mono);
  font-size: 10px;
}

.schedule-cell input:focus {
  background: rgba(255,0,160,.06);
  box-shadow: inset 0 0 10px rgba(255,0,160,.15);
}

.schedule-cell.current-hour {
  box-shadow: inset 0 0 0 1px rgba(0,243,255,.55);
}

/* =========================================================
   General controls
   ========================================================= */

.form-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 9px;
}

.field {
  min-width: 0;
}

.field.full {
  grid-column: 1 / -1;
}

.field label {
  display: block;
  margin-bottom: 5px;
  color: var(--muted);
  font-family: var(--mono);
  font-size: 9px;
  text-transform: uppercase;
  letter-spacing: .06em;
}

.field input,
.field textarea,
.field select {
  padding: 8px;
  font-size: 12px;
}

textarea {
  min-height: 64px;
  resize: vertical;
}

.section-label {
  margin: 15px 0 8px;
  padding-bottom: 5px;
  color: var(--cyan);
  border-bottom: 1px solid rgba(0,243,255,.18);
  font-family: var(--mono);
  font-size: 10px;
  letter-spacing: .1em;
  text-transform: uppercase;
}

/* =========================================================
   Checklists
   ========================================================= */

.checklist {
  display: flex;
  flex-direction: column;
  gap: 7px;
}

.check-row {
  min-width: 0;
  display: grid;
  grid-template-columns: 21px minmax(0, 1fr) 25px;
  gap: 7px;
  align-items: center;
  padding: 7px;
  border: 1px solid rgba(169,160,199,.13);
  background: rgba(0,0,0,.15);
}

.check-row input[type="text"] {
  border: 0;
  padding: 3px;
  background: transparent;
  font-size: 11px;
}

.check-row.done input[type="text"] {
  color: var(--dim);
  text-decoration: line-through;
}

.check-box {
  appearance: none;
  width: 17px;
  height: 17px;
  margin: 0;
  border: 1px solid var(--pink);
  background: #0a0710;
  cursor: pointer;
  position: relative;
}

.check-box:checked {
  background: rgba(255,0,160,.2);
  box-shadow: 0 0 10px rgba(255,0,160,.55);
}

.check-box:checked::after {
  content: "✓";
  position: absolute;
  inset: -2px 0 0;
  text-align: center;
  color: var(--pink);
  font-weight: 900;
  font-size: 14px;
}

.delete-btn {
  width: 24px;
  height: 24px;
  padding: 0;
  color: var(--dim);
  border-color: rgba(169,160,199,.15);
  box-shadow: none;
}

.add-row {
  margin-top: 8px;
  width: 100%;
}

/* =========================================================
   Shift tracker
   ========================================================= */

.shift-summary {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 6px;
  margin-bottom: 10px;
}

.status-card {
  padding: 8px 5px;
  text-align: center;
  border: 1px solid rgba(169,160,199,.15);
  background: rgba(0,0,0,.18);
}

.status-value {
  font-family: var(--mono);
  font-size: 11px;
  font-weight: 700;
}

.status-caption {
  margin-top: 3px;
  color: var(--dim);
  font-size: 8px;
  text-transform: uppercase;
}

.shift-table {
  display: grid;
  grid-template-columns: 62px minmax(65px, 1fr) minmax(72px, 1.2fr);
  border-top: 1px solid rgba(169,160,199,.14);
  border-left: 1px solid rgba(169,160,199,.14);
}

.shift-table > div {
  min-width: 0;
  padding: 7px 5px;
  border-right: 1px solid rgba(169,160,199,.14);
  border-bottom: 1px solid rgba(169,160,199,.14);
  font-family: var(--mono);
  font-size: 9px;
}

.shift-head {
  color: var(--cyan);
  background: #100b1b;
}

.shift-row-on {
  color: var(--pink);
}

.shift-row-off {
  color: var(--muted);
}

.shift-row-dismount {
  color: var(--cyan);
}

.shift-controls {
  display: flex;
  gap: 5px;
  flex-wrap: wrap;
  margin-bottom: 9px;
}

.flag {
  display: inline-flex;
  align-items: center;
  gap: 5px;
  color: var(--muted);
  font-size: 9px;
}

.flag input {
  width: auto;
}

/* =========================================================
   Budget
   ========================================================= */

.budget-metrics {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 7px;
  margin-bottom: 12px;
}

.metric-box {
  min-width: 0;
  padding: 8px;
  border: 1px solid rgba(255,0,85,.2);
  background: rgba(0,0,0,.18);
}

.metric-name {
  color: var(--muted);
  font-family: var(--mono);
  font-size: 8px;
  text-transform: uppercase;
}

.metric-value {
  margin-top: 4px;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  color: var(--pink);
  font-family: var(--mono);
  font-size: 15px;
}

.chart-wrap {
  position: relative;
  width: 100%;
  min-height: 220px;
  height: 260px;
}

.chart-wrap canvas {
  max-width: 100%;
}

.budget-log {
  margin-top: 10px;
  max-height: 160px;
  overflow: auto;
}

.budget-entry {
  display: grid;
  grid-template-columns: 76px minmax(0, 1fr) 80px 24px;
  gap: 5px;
  align-items: center;
  padding: 5px 0;
  border-bottom: 1px solid rgba(169,160,199,.1);
}

.budget-entry span {
  font-family: var(--mono);
  font-size: 9px;
  color: var(--muted);
}

.budget-entry .amount {
  color: var(--pink);
  text-align: right;
}

/* =========================================================
   Goals / Running
   ========================================================= */

.goal-list {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 10px;
}

.goal {
  min-width: 0;
  padding: 10px;
  border: 1px solid rgba(255,0,85,.2);
  background: rgba(0,0,0,.16);
}

.goal-head {
  display: flex;
  justify-content: space-between;
  gap: 8px;
  align-items: center;
  margin-bottom: 7px;
}

.goal-name {
  min-width: 0;
  color: var(--pink);
  font-family: var(--mono);
  font-size: 10px;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.goal-percent {
  flex: 0 0 auto;
  color: var(--cyan);
  font-family: var(--mono);
  font-size: 10px;
}

.progress {
  height: 8px;
  overflow: hidden;
  border: 1px solid rgba(169,160,199,.2);
  background: #09070e;
}

.progress > div {
  height: 100%;
  width: 0;
  background: linear-gradient(90deg, var(--red), var(--pink));
  box-shadow: 0 0 10px rgba(255,0,160,.6);
  transition: width .25s;
}

.goal-fields {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 6px;
  margin-top: 8px;
}

.goal-fields input {
  font-size: 10px;
  padding: 6px;
}

.run-layout {
  display: grid;
  grid-template-columns: minmax(0, .8fr) minmax(0, 1.2fr);
  gap: 14px;
  margin-top: 14px;
}

.pace-display {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 100%;
  padding: 18px;
  border: 1px solid rgba(0,243,255,.2);
  background: rgba(0,243,255,.025);
  text-align: center;
}

.pace-value {
  color: var(--cyan);
  font-family: var(--mono);
  font-size: clamp(28px, 5vw, 46px);
  text-shadow: 0 0 12px rgba(0,243,255,.5);
}

.pace-unit {
  color: var(--muted);
  font-family: var(--mono);
  font-size: 10px;
}

.run-log {
  max-height: 190px;
  overflow: auto;
  margin-top: 8px;
}

.run-entry {
  display: grid;
  grid-template-columns: 74px 1fr 74px 74px 24px;
  gap: 5px;
  padding: 6px 0;
  border-bottom: 1px solid rgba(169,160,199,.1);
  font-family: var(--mono);
  font-size: 9px;
  color: var(--muted);
}

.run-entry strong {
  color: var(--pink);
  font-weight: normal;
}

/* =========================================================
   Footer
   ========================================================= */

.system-footer {
  padding: 10px 2px 2px;
  display: flex;
  justify-content: space-between;
  gap: 10px;
  flex-wrap: wrap;
  color: var(--dim);
  font-family: var(--mono);
  font-size: 9px;
}

.save-indicator {
  color: var(--cyan);
}

/* =========================================================
   Container queries
   ========================================================= */

@container (max-width: 1050px) {
  .checklist-module,
  .shift-module,
  .budget-module {
    grid-column: span 6;
  }

  .budget-module {
    grid-column: 1 / -1;
  }
}

@container (max-width: 720px) {
  .header-grid,
  .run-layout {
    grid-template-columns: 1fr;
  }

  .checklist-module,
  .shift-module,
  .budget-module {
    grid-column: 1 / -1;
  }

  .goal-list {
    grid-template-columns: 1fr;
  }

  .clock {
    font-size: clamp(30px, 11vw, 58px);
  }

  .timetable {
    grid-template-columns: 43px repeat(7, minmax(0, 1fr));
  }

  .day-head {
    font-size: 9px;
  }

  .day-head .day-date {
    font-size: 8px;
  }

  .schedule-cell input {
    padding: 4px 2px;
    font-size: 8px;
  }

  .time-cell {
    font-size: 8px;
  }

  .budget-metrics {
    grid-template-columns: 1fr;
  }

  .run-entry {
    grid-template-columns: 1fr 1fr 1fr;
  }

  .run-entry .delete-btn {
    display: none;
  }
}

@media (max-width: 480px) {
  .app {
    padding: 7px;
  }

  .module-body {
    padding: 9px;
  }

  .form-grid {
    grid-template-columns: 1fr;
  }

  .field.full {
    grid-column: auto;
  }

  .alarm-panel {
    grid-template-columns: 1fr auto;
  }

  .week-toolbar {
    align-items: flex-start;
    flex-direction: column;
  }

  .week-actions {
    width: 100%;
  }

  .week-actions button {
    flex: 1;
  }

  .timetable {
    grid-template-columns: 34px repeat(7, minmax(0, 1fr));
  }

  .time-head,
  .day-head {
    min-height: 42px;
  }

  .time-cell,
  .schedule-cell,
  .schedule-cell input {
    min-height: 37px;
  }

  .day-head {
    writing-mode: horizontal-tb;
  }

  .day-head .day-date {
    display: none;
  }
}
</style>
</head>

<body>
<div class="app">

  <div class="dashboard">

    <!-- =====================================================
         MODULE 1: CLOCK / ALARM
         ===================================================== -->
    <section class="module header-module">
