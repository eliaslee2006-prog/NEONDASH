    <span class="save-indicator" id="saveIndicator">LOCAL STORAGE READY</span>
  </div>

</div>


<script>
/* =========================================================
   NEON // OPERATIONS DASHBOARD
   Structured localStorage state engine
   ========================================================= */

(() => {
  "use strict";

  const STORAGE_KEY = "neon_ops_dashboard_v1";

  let state = {
    alarm: {
      time: "07:00",
      armed: false
    },

    timetable: {},

    checklists: {
      daily: [
        { id: uid(), text: "Review daily priorities", done: false },
        { id: uid(), text: "Check communications / messages", done: false },
        { id: uid(), text: "Confirm equipment status", done: false }
      ],
      ops: [
        { id: uid(), text: "Equipment inspection", done: false },
        { id: uid(), text: "Circuit / power check", done: false },
        { id: uid(), text: "Maintenance log updated", done: false }
      ],
      maintenanceLog: ""
    },

    shift: {
      anchor: "",
      coverageOverride: false,
      overrides: {}
    },

    budget: {
      limit: 0,
      spend: 0,
      gold: 0,
      brent: 0,
      entries: []
    },

    goals: {
      goal1Current: 0,
      goal1Target: 100,
      goal2Current: 0,
      goal2Target: 10,
      goal3Current: 0,
      goal3Target: 100
    },

    runs: []
  };

  let currentWeekOffset = 0;
  let budgetChart = null;

  let audioContext = null;
  let alarmOscillators = [];
  let alarmGain = null;
  let alarmActive = false;
  let lastAlarmTrigger = "";

  /* =======================================================
     Utilities
     ======================================================= */

  function uid() {
    return (
      Date.now().toString(36) +
      Math.random().toString(36).slice(2, 8)
    );
  }

  function deepMerge(target, source) {
    if (!source || typeof source !== "object") return target;

    Object.keys(source).forEach(key => {
      if (
        source[key] &&
        typeof source[key] === "object" &&
        !Array.isArray(source[key])
      ) {
        if (!target[key] || typeof target[key] !== "object") {
          target[key] = {};
        }
        deepMerge(target[key], source[key]);
      } else {
        target[key] = source[key];
      }
    });

    return target;
  }

  function formatMoney(value) {
    const n = Number(value) || 0;

    return new Intl.NumberFormat("en-US", {
      style: "currency",
      currency: "USD",
      maximumFractionDigits: 2
    }).format(n);
  }

  function pad(n) {
    return String(n).padStart(2, "0");
  }

  function dateKey(date) {
    return [
      date.getFullYear(),
      pad(date.getMonth() + 1),
      pad(date.getDate())
    ].join("-");
  }

  function parseDate(value) {
    if (!value) return null;

    const parts = value.split("-").map(Number);

    if (parts.length !== 3) return null;

    return new Date(
      parts[0],
      parts[1] - 1,
      parts[2]
    );
  }

  function mondayOf(date) {
    const d = new Date(date);
    d.setHours(0, 0, 0, 0);

    const day = d.getDay();
    const diff = day === 0 ? -6 : 1 - day;

    d.setDate(d.getDate() + diff);

    return d;
  }

  function addDays(date, amount) {
    const d = new Date(date);
    d.setDate(d.getDate() + amount);
    return d;
  }

  function formatShortDate(date) {
    return date.toLocaleDateString(undefined, {
      month: "short",
      day: "numeric"
    });
  }

  function formatLongDate(date) {
    return date.toLocaleDateString(undefined, {
      weekday: "long",
      year: "numeric",
      month: "long",
      day: "numeric"
    });
  }

  function isoWeek(date) {
    const d = new Date(
      Date.UTC(
        date.getFullYear(),
        date.getMonth(),
        date.getDate()
      )
    );

    const dayNum = d.getUTCDay() || 7;

    d.setUTCDate(
      d.getUTCDate() + 4 - dayNum
    );

    const yearStart = new Date(
      Date.UTC(d.getUTCFullYear(), 0, 1)
    );

    return Math.ceil(
      (((d - yearStart) / 86400000) + 1) / 7
    );
  }

  function weekStorageKey(monday) {
    return (
      monday.getFullYear() +
      "-W" +
      pad(isoWeek(monday))
    );
  }

  function setSaveIndicator(message = "SAVED LOCALLY") {
    const el = document.getElementById("saveIndicator");

    if (!el) return;

    el.textContent = message;

    clearTimeout(setSaveIndicator.timer);

    setSaveIndicator.timer = setTimeout(() => {
      el.textContent = "LOCAL STORAGE READY";
    }, 900);
  }

  /* =======================================================
     Required State Functions
     ======================================================= */

  function saveState() {
    try {
      localStorage.setItem(
        STORAGE_KEY,
        JSON.stringify(state)
      );

      setSaveIndicator();
    } catch (error) {
      console.error("localStorage save failed:", error);
      setSaveIndicator("STORAGE ERROR");
    }
  }

  function loadState() {
    try {
      const raw = localStorage.getItem(STORAGE_KEY);

      if (!raw) return;

      const parsed = JSON.parse(raw);

      deepMerge(state, parsed);
    } catch (error) {
      console.error("localStorage load failed:", error);
      setSaveIndicator("STORAGE READ ERROR");
    }
  }

  /* =======================================================
     Module 1: Clock / Alarm / Web Audio
     ======================================================= */

  function updateClock() {
    const now = new Date();

    const clock = document.getElementById("digitalClock");
    const dateReadout = document.getElementById("dateReadout");

    clock.textContent =
      pad(now.getHours()) +
      ":" +
      pad(now.getMinutes()) +
      ":" +
      pad(now.getSeconds());

    dateReadout.textContent =
      formatLongDate(now);

    checkAlarm(now);
  }

  function initAudio() {
    if (!audioContext) {
      const AudioCtx =
        window.AudioContext ||
        window.webkitAudioContext;

      if (!AudioCtx) {
        alert("Web Audio API is not supported in this browser.");
        return null;
      }

      audioContext = new AudioCtx();
    }

    if (audioContext.state === "suspended") {
      audioContext.resume();
    }

    return audioContext;
  }

  function beepOnce(startTime, frequency = 880, duration = .22) {
    if (!audioContext) return;

    const oscillator =
      audioContext.createOscillator();

    const gain =
      audioContext.createGain();

    oscillator.type = "square";
    oscillator.frequency.setValueAtTime(
      frequency,
      startTime
    );

    gain.gain.setValueAtTime(
      .0001,
      startTime
    );

    gain.gain.exponentialRampToValueAtTime(
      .65,
      startTime + .015
    );

    gain.gain.exponentialRampToValueAtTime(
      .0001,
      startTime + duration
    );

    oscillator.connect(gain);
    gain.connect(audioContext.destination);

    oscillator.start(startTime);
    oscillator.stop(startTime + duration);

    alarmOscillators.push(oscillator);
  }

  function startAlarm() {
    initAudio();

    if (!audioContext) return;

    stopAlarm(false);

    alarmActive = true;

    document
      .getElementById("alarmBanner")
      .classList.add("active");

    let t = audioContext.currentTime + .03;

    for (let i = 0; i < 12; i++) {
      beepOnce(
        t,
        i % 2 === 0 ? 880 : 1320,
        .24
      );

      beepOnce(
        t + .28,
        i % 2 === 0 ? 660 : 1100,
        .18
      );

      t += .7;
    }
  }

  function stopAlarm(showState = true) {
    alarmOscillators.forEach(osc => {
      try {
        osc.stop();
      } catch (_) {}
    });

    alarmOscillators = [];

    alarmActive = false;

    document
      .getElementById("alarmBanner")
      .classList.remove("active");

    if (showState) {
      document.getElementById("systemStatus").textContent =
        "ALARM SILENCED";
    }
  }

  function checkAlarm(now) {
    if (!state.alarm.armed || alarmActive) return;

    const current =
      pad(now.getHours()) +
      ":" +
      pad(now.getMinutes());

    const triggerKey =
      dateKey(now) + "_" + current;

    if (
      current === state.alarm.time &&
      lastAlarmTrigger !== triggerKey
    ) {
      lastAlarmTrigger = triggerKey;
      startAlarm();
    }
  }

  function renderAlarm() {
    document.getElementById("alarmTime").value =
      state.alarm.time || "07:00";

    document.getElementById("alarmArmed").checked =
      Boolean(state.alarm.armed);

    document.getElementById("armLabel").textContent =
      state.alarm.armed ? "ARM" : "DISARM";
  }

  document
    .getElementById("alarmTime")
    .addEventListener("change", e => {
      state.alarm.time = e.target.value;
      saveState();
    });

  document
    .getElementById("alarmArmed")
    .addEventListener("change", e => {
      state.alarm.armed = e.target.checked;

      document.getElementById("armLabel").textContent =
        state.alarm.armed ? "ARM" : "DISARM";

      document.getElementById("systemStatus").textContent =
        state.alarm.armed
          ? "ALARM ARMED"
          : "SYSTEM ONLINE";

      initAudio();
      saveState();
    });

  document
    .getElementById("audioTestBtn")
    .addEventListener("click", () => {
      initAudio();

      if (!audioContext) return;

      const t = audioContext.currentTime;

      beepOnce(t, 660, .18);
      beepOnce(t + .25, 990, .18);
      beepOnce(t + .5, 1320, .25);
    });

  document
    .getElementById("stopAlarmBtn")
    .addEventListener("click", () => {
      stopAlarm();
    });

  /* =======================================================
     Module 2: Timetable
     ======================================================= */

  const dayNames = [
    "MON",
    "TUE",
    "WED",
    "THU",
    "FRI",
    "SAT",
    "SUN"
  ];

  function renderTimetable() {
    const today = new Date();

    let monday = mondayOf(today);

    monday = addDays(
      monday,
      currentWeekOffset * 7
    );

    const weekKey = weekStorageKey(monday);

    const sunday = addDays(monday, 6);

    document.getElementById("weekLabel").textContent =
      "WEEK " +
      isoWeek(monday) +
      " // " +
      formatShortDate(monday) +
      " — " +
      formatShortDate(sunday);

    document.getElementById("weekKeyReadout").textContent =
      weekKey;

    const container =
      document.getElementById("timetable");

    container.innerHTML = "";

    const corner = document.createElement("div");

    corner.className = "time-head";
    corner.textContent = "TIME";

    container.appendChild(corner);

    for (let day = 0; day < 7; day++) {
      const date = addDays(monday, day);

      const head =
        document.createElement("div");

      head.className = "day-head";

      head.innerHTML = `
        <span>${dayNames[day]}</span>
        <span class="day-date">${formatShortDate(date)}</span>
      `;

      container.appendChild(head);
    }

    for (let hour = 0; hour < 24; hour++) {
      const timeCell =
        document.createElement("div");

      timeCell.className = "time-cell";
      timeCell.textContent = pad(hour) + ":00";

      container.appendChild(timeCell);

      for (let day = 0; day < 7; day++) {
        const date = addDays(monday, day);

        const cell =
          document.createElement("div");

        cell.className = "schedule-cell";

        const input =
          document.createElement("input");

        input.type = "text";
        input.placeholder = "—";

        /*
          Unique storage key:
          week / calendar date / day / hour
        */
        const key =
          weekKey +
          "__" +
          dateKey(date) +
          "__D" +
          day +
          "__H" +
          hour;

        input.dataset.storageKey = key;

        input.value =
          state.timetable[key] || "";

        if (
          dateKey(date) === dateKey(today) &&
          hour === today.getHours()
        ) {
          cell.classList.add("current-hour");
        }

        input.addEventListener("input", e => {
          state.timetable[key] = e.target.value;
          saveState();
        });

        cell.appendChild(input);
        container.appendChild(cell);
      }
    }
  }

  document
    .getElementById("prevWeek")
    .addEventListener("click", () => {
      currentWeekOffset--;
      renderTimetable();
    });

  document
    .getElementById("thisWeek")
    .addEventListener("click", () => {
      currentWeekOffset = 0;
      renderTimetable();
    });

  document
    .getElementById("nextWeek")
    .addEventListener("click", () => {
      currentWeekOffset++;
      renderTimetable();
    });

  /* =======================================================
     Module 3: Checklists
     ======================================================= */

  function renderChecklist(type) {
    const container =
      document.getElementById(
        type === "daily"
          ? "dailyChecklist"
          : "opsChecklist"
      );

    container.innerHTML = "";

    state.checklists[type].forEach(item => {
      const row =
        document.createElement("div");

      row.className =
        "check-row" +
        (item.done ? " done" : "");

      const checkbox =
        document.createElement("input");

      checkbox.type = "checkbox";
      checkbox.className = "check-box";
      checkbox.checked = item.done;

      checkbox.addEventListener("change", () => {
        item.done = checkbox.checked;
        renderChecklist(type);
        saveState();
      });

      const text =
        document.createElement("input");

      text.type = "text";
      text.value = item.text;
      text.placeholder = "Task / procedure...";

      text.addEventListener("input", () => {
        item.text = text.value;
        saveState();
      });

      const deleteButton =
        document.createElement("button");

      deleteButton.className = "delete-btn";
      deleteButton.textContent = "×";
      deleteButton.title = "Delete task";

      deleteButton.addEventListener("click", () => {
        state.checklists[type] =
          state.checklists[type].filter(
            x => x.id !== item.id
          );

        renderChecklist(type);
        saveState();
      });

      row.append(
        checkbox,
        text,
        deleteButton
      );

      container.appendChild(row);
    });
  }

  function addChecklistItem(type, defaultText) {
    state.checklists[type].push({
      id: uid(),
      text: defaultText,
      done: false
    });

    renderChecklist(type);
    saveState();
  }

  document
    .getElementById("addDailyTask")
    .addEventListener("click", () => {
      addChecklistItem(
        "daily",
        "New daily task"
      );
    });

  document
    .getElementById("addOpsTask")
    .addEventListener("click", () => {
      addChecklistItem(
        "ops",
        "New operational procedure"
      );
    });

  document
    .getElementById("maintenanceLog")
    .addEventListener("input", e => {
      state.checklists.maintenanceLog =
        e.target.value;

      saveState();
    });

  /* =======================================================
     Module 4: Shift Rotation
     ======================================================= */

  function getShiftStatus(date) {
    const anchor =
      parseDate(state.shift.anchor) ||
      mondayOf(new Date());

    anchor.setHours(0, 0, 0, 0);

    const d = new Date(date);
    d.setHours(0, 0, 0, 0);

    const diff =
      Math.round(
        (d - anchor) / 86400000
      );

    const cycle =
      ((diff % 4) + 4) % 4;

    if (cycle < 2) return "ON DUTY";

    return "OFF DUTY";
  }

  function renderShift() {
    const table =
      document.getElementById("shiftTable");

    table.innerHTML = "";

    const headers = [
      "DATE",
      "STATUS",
      "FLAG"
    ];

    headers.forEach(header => {
      const div =
        document.createElement("div");

      div.className = "shift-head";
      div.textContent = header;

      table.appendChild(div);
    });

    let on = 0;
    let off = 0;
    let overrides = 0;

    const today = new Date();

    for (let i = 0; i < 28; i++) {
      const anchor =
        parseDate(state.shift.anchor) ||
        mondayOf(today);

      const date =
        addDays(anchor, i);

      const key = dateKey(date);

      let status =
        getShiftStatus(date);

      const isOverride =
        Boolean(state.shift.overrides[key]);

      if (isOverride) {
        status = "DISMOUNT";
        overrides++;
      } else if (status === "ON DUTY") {
        on++;
      } else {
        off++;
      }

      const dateDiv =
        document.createElement("div");

      dateDiv.textContent =
        formatShortDate(date);

      if (
        dateKey(date) === dateKey(today)
      ) {
        dateDiv.style.color = "var(--cyan)";
        dateDiv.style.fontWeight = "700";
      }

      const statusDiv =
        document.createElement("div");

      statusDiv.textContent = status;

      statusDiv.className =
        status === "ON DUTY"
          ? "shift-row-on"
          : status === "OFF DUTY"
            ? "shift-row-off"
            : "shift-row-dismount";

      const flagDiv =
        document.createElement("div");

      const flag =
        document.createElement("input");

      flag.type = "checkbox";
      flag.checked = isOverride;
      flag.title = "Coverage / absenteeism override";

      flag.addEventListener("change", () => {
        if (flag.checked) {
          state.shift.overrides[key] = true;
        } else {
          delete state.shift.overrides[key];
        }

        renderShift();
        saveState();
      });

      flagDiv.appendChild(flag);

      table.append(
        dateDiv,
        statusDiv,
        flagDiv
      );
    }

    document.getElementById("onCount").textContent = on;
    document.getElementById("offCount").textContent = off;
    document.getElementById("overrideCount").textContent = overrides;
  }

  document
    .getElementById("rotationAnchor")
    .addEventListener("change", e => {
      state.shift.anchor =
        e.target.value;

      renderShift();
      saveState();
    });

  document
    .getElementById("coverageOverride")
    .addEventListener("change", e => {
      state.shift.coverageOverride =
        e.target.checked;

      saveState();
    });

  /* =======================================================
     Module 5: Budget / Chart
     ======================================================= */

  function renderBudget() {
    const limit =
      Number(state.budget.limit) || 0;

    const spend =
      Number(state.budget.spend) || 0;

    const remaining =
      limit - spend;

    document.getElementById("budgetMetric")
      .textContent = formatMoney(limit);

    document.getElementById("spendMetric")
      .textContent = formatMoney(spend);

    document.getElementById("remainingMetric")
      .textContent = formatMoney(remaining);

    document.getElementById("budgetLimit").value =
      state.budget.limit || "";

    document.getElementById("actualSpend").value =
      state.budget.spend || "";

    document.getElementById("goldPrice").value =
      state.budget.gold || "";

    document.getElementById("brentPrice").value =
      state.budget.brent || "";

    renderBudgetLog();
    renderBudgetChart();
  }

  function renderBudgetLog() {
    const container =
      document.getElementById("budgetLog");

    container.innerHTML = "";

    const entries =
      state.budget.entries || [];

    [...entries]
      .reverse()
      .forEach(entry => {
        const row =
          document.createElement("div");

        row.className = "budget-entry";

        const date =
          document.createElement("span");

        date.textContent = entry.date;

        const label =
          document.createElement("span");

        label.textContent = entry.label;

        const amount =
          document.createElement("span");

        amount.className = "amount";
        amount.textContent =
          formatMoney(entry.value);

        const deleteButton =
          document.createElement("button");

        deleteButton.className =
          "delete-btn";

        deleteButton.textContent = "×";

        deleteButton.addEventListener("click", () => {
          state.budget.entries =
            state.budget.entries.filter(
              x => x.id !== entry.id
            );

          renderBudget();
          saveState();
        });

        row.append(
          date,
          label,
          amount,
          deleteButton
        );

        container.appendChild(row);
      });
  }

  function renderBudgetChart() {
    if (
      typeof Chart === "undefined"
    ) {
      return;
    }

    const canvas =
      document.getElementById("budgetChart");

    const entries =
      state.budget.entries || [];

    const labels =
      entries.map(x => x.date);

    const values =
      entries.map(x => Number(x.value) || 0);

    if (budgetChart) {
      budgetChart.destroy();
    }

    budgetChart =
      new Chart(canvas, {
        type: "line",

        data: {
          labels,

          datasets: [
            {
              label: "Budget / Market Data",
              data: values,
              borderColor: "#ff0055",
              backgroundColor: "rgba(255,0,85,.08)",
              pointBackgroundColor: "#ff71ce",
              pointBorderColor: "#ff71ce",
              pointRadius: 3,
              pointHoverRadius: 6,
              borderWidth: 2,
              tension: .25,
              fill: true
            }
          ]
        },

        options: {
          responsive: true,
          maintainAspectRatio: false,

          interaction: {
            intersect: false,
            mode: "index"
          },

          plugins: {
            legend: {
              labels: {
                color: "#a9a0c7",
                font: {
                  family: "Courier New"
                }
              }
            },

            tooltip: {
              backgroundColor: "#120c1f",
              borderColor: "#ff0055",
              borderWidth: 1,
              titleColor: "#ff71ce",
              bodyColor: "#eee9ff"
            }
          },

          scales: {
            x: {
              ticks: {
                color: "#706887",
                font: {
                  family: "Courier New",
                  size: 9
                }
              },

              grid: {
                color: "rgba(169,160,199,.08)"
              }
            },

            y: {
              ticks: {
                color: "#706887",
                font: {
                  family: "Courier New",
                  size: 9
                }
              },

              grid: {
                color: "rgba(169,160,199,.08)"
              }
            }
          }
        }
      });
  }

  [
    ["budgetLimit", "limit"],
    ["actualSpend", "spend"],
    ["goldPrice", "gold"],
    ["brentPrice", "brent"]
  ].forEach(([id, key]) => {
    document
      .getElementById(id)
      .addEventListener("input", e => {
        state.budget[key] =
          Number(e.target.value) || 0;

        renderBudget();
        saveState();
      });
  });

  document
    .getElementById("addBudgetEntry")
    .addEventListener("click", () => {
      const value =
        Number(
          document.getElementById(
            "budgetEntryValue"
          ).value
        );

      const label =
        document.getElementById(
          "budgetEntryLabel"
        ).value.trim() ||
        "Data point";

      if (!Number.isFinite(value)) {
        return;
      }

      state.budget.entries.push({
        id: uid(),
        date: new Date().toLocaleDateString(),
        label,
        value
      });

      document.getElementById(
        "budgetEntryValue"
      ).value = "";

      document.getElementById(
        "budgetEntryLabel"
      ).value = "";

      renderBudget();
      saveState();
    });

  /* =======================================================
     Module 6: Goals
     ======================================================= */

  const goalFields = [
    "goal1Current",
    "goal1Target",
    "goal2Current",
    "goal2Target",
    "goal3Current",
    "goal3Target"
  ];

  function renderGoals() {
    for (let i = 1; i <= 3; i++) {
      const current =
        Number(
          state.goals[
            "goal" + i + "Current"
          ]
        ) || 0;

      const target =
        Number(
          state.goals[
            "goal" + i + "Target"
          ]
        ) || 0;

      const percent =
        target > 0
          ? Math.min(
              100,
              Math.max(
                0,
                (current / target) * 100
              )
            )
          : 0;

      document.getElementById(
        "goal" + i + "Current"
      ).value = current;

      document.getElementById(
        "goal" + i + "Target"
      ).value = target;

      document.getElementById(
        "goal" + i + "Percent"
      ).textContent =
        Math.round(percent) + "%";

      document.getElementById(
        "goal" + i + "Bar"
      ).style.width =
        percent + "%";
    }
  }

  goalFields.forEach(id => {
    document
      .getElementById(id)
      .addEventListener("input", e => {
        state.goals[id] =
          Number(e.target.value) || 0;

        renderGoals();
        saveState();
      });
  });

  /* =======================================================
     Running Metrics
     ======================================================= */

  function parseDuration(value) {
    if (!value) return NaN;

    const parts =
      value.trim().split(":").map(Number);

    if (
      parts.length !== 2 &&
      parts.length !== 3
    ) {
      return NaN;
    }

    if (parts.some(x => !Number.isFinite(x))) {
      return NaN;
    }

    if (parts.length === 2) {
      return (
        parts[0] * 60 +
        parts[1]
      );
    }

    return (
      parts[0] * 3600 +
      parts[1] * 60 +
      parts[2]
    );
  }

  function formatPace(minutesPerKm) {
    if (
      !Number.isFinite(minutesPerKm) ||
      minutesPerKm <= 0
    ) {
      return "--:--";
    }

    const totalSeconds =
      Math.round(
        minutesPerKm * 60
      );

    const minutes =
      Math.floor(
        totalSeconds / 60
      );

    const seconds =
      totalSeconds % 60;

    return (
      pad(minutes) +
      ":" +
      pad(seconds)
    );
  }

  function updateCurrentPace() {
    const distance =
      Number(
        document.getElementById(
          "runDistance"
        ).value
      );

    const seconds =
      parseDuration(
        document.getElementById(
          "runTime"
        ).value
      );

    const pace =
      distance > 0 && Number.isFinite(seconds)
        ? (seconds / 60) / distance
        : NaN;

    document.getElementById(
      "paceValue"
    ).textContent =
      formatPace(pace);
  }

  document
    .getElementById("runDistance")
    .addEventListener(
      "input",
      updateCurrentPace
    );

  document
    .getElementById("runTime")
    .addEventListener(
      "input",
      updateCurrentPace
    );

  function renderRunLog() {
    const container =
      document.getElementById("runLog");

    container.innerHTML = "";

    [...state.runs]
      .reverse()
      .forEach(run => {
        const row =
          document.createElement("div");

        row.className = "run-entry";

        const date =
          document.createElement("span");

        date.textContent = run.date;

        const distance =
          document.createElement("strong");

        distance.textContent =
          Number(run.distance).toFixed(2) +
          " km";

        const duration =
          document.createElement("span");

        duration.textContent =
          run.duration;

        const pace =
          document.createElement("strong");

        pace.textContent =
          run.pace +
          " /km";

        const deleteButton =
          document.createElement("button");

        deleteButton.className =
          "delete-btn";

        deleteButton.textContent = "×";

        deleteButton.addEventListener(
          "click",
          () => {
            state.runs =
              state.runs.filter(
                x => x.id !== run.id
              );

            renderRunLog();
            saveState();
          }
        );

        row.append(
          date,
          distance,
          duration,
          pace,
          deleteButton
        );

        container.appendChild(row);
      });
  }

  document
    .getElementById("addRun")
    .addEventListener("click", () => {
      const distance =
        Number(
          document.getElementById(
            "runDistance"
          ).value
        );

      const duration =
        document.getElementById(
          "runTime"
        ).value.trim();

      const seconds =
        parseDuration(duration);

      if (
        !Number.isFinite(distance) ||
        distance <= 0 ||
        !Number.isFinite(seconds) ||
        seconds <= 0
      ) {
        alert(
          "Enter a valid distance and elapsed time."
        );

        return;
      }

      const pace =
        formatPace(
          (seconds / 60) /
          distance
        );

      state.runs.push({
        id: uid(),
        date: new Date().toLocaleDateString(),
        distance,
        duration,
        pace
      });

      document.getElementById(
        "runDistance"
      ).value = "";

      document.getElementById(
        "runTime"
      ).value = "";

      document.getElementById(
        "paceValue"
      ).textContent = "--:--";

      renderRunLog();
      saveState();
    });

  /* =======================================================
     Initialization
     ======================================================= */

  function initializeDefaults() {
    if (!state.shift.anchor) {
      state.shift.anchor =
        dateKey(mondayOf(new Date()));
    }

    if (!Array.isArray(state.runs)) {
      state.runs = [];
    }

    if (!Array.isArray(state.budget.entries)) {
      state.budget.entries = [];
    }

    if (!state.checklists.daily.length) {
      state.checklists.daily = [];
    }

    if (!state.checklists.ops.length) {
      state.checklists.ops = [];
    }
  }

  function renderEverything() {
    renderAlarm();

    renderTimetable();

    renderChecklist("daily");
    renderChecklist("ops");

    document.getElementById(
      "maintenanceLog"
    ).value =
      state.checklists.maintenanceLog || "";

    document.getElementById(
      "rotationAnchor"
    ).value =
      state.shift.anchor;

    document.getElementById(
      "coverageOverride"
    ).checked =
      Boolean(
        state.shift.coverageOverride
      );

    renderShift();
    renderBudget();
    renderGoals();
    renderRunLog();
  }

  loadState();
  initializeDefaults();
  renderEverything();

  updateClock();

  setInterval(
    updateClock,
    1000
  );

  /*
    Re-render timetable at the start of each minute
    so current-hour highlighting stays accurate.
  */
  setInterval(() => {
    renderTimetable();
  }, 60000);

  /*
    Persist defaults if they were created during initialization.
  */
  saveState();

})();
</script>

</body>
</html>
